# Copie este arquivo para ".env" e preencha com os dados do SEU projeto Supabase
# (Supabase → Project Settings → API).
#
# Use SOMENTE a chave pública "anon" / "publishable". NUNCA coloque aqui a chave
# "service_role" / "secret": ela daria acesso total ao banco.
#
# Alternativa sem recompilar: edite o arquivo "config.json" que fica ao lado do
# index.html publicado (pasta "3o ano/monstrinhos/").
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=cole-aqui-a-chave-anon-publica
